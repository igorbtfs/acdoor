# .env.example
# Copie este arquivo para .env e preencha. O .env NUNCA deve ir para o git.

# Credenciais OAuth do Google (console.cloud.google.com > APIs e serviços > Credenciais)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Configurações do Django
# Gere a chave com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
# IPs/domínios pelos quais o portal é acessado, separados por vírgula
ALLOWED_HOSTS=IP_DO_SEU_SERVIDOR_PROXMOX
# Normalmente não é preciso (o proxy repassa o X-Forwarded-Proto).
# CSRF_TRUSTED_ORIGINS=https://acdoor.exemplo.com

# E-mails que viram administradores ao entrar com o Google (separados por vírgula).
# Precisam ser de um domínio institucional aceito no login.
# Ex.: ADMIN_EMAILS=matricula@aluno.restinga.ifrs.edu.br,professor@restinga.ifrs.edu.br
ADMIN_EMAILS=

# Regras de acesso (opcionais; estes são os padrões)
# ACESSO_VALIDADE_PADRAO_DIAS=180   # validade sugerida ao conceder ou renovar
# ACESSO_VALIDADE_MAXIMA_DIAS=366   # prazo máximo por concessão
# CARTAO_PENDENTE_MINUTOS=10        # janela para vincular um cartão recém-lido

# Configurações do PostgreSQL (docker-compose usa estes nomes)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Formato: postgres://USUARIO:SENHA@db:5432/BANCO
DATABASE_URL=
